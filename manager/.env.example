# Optional API origin override for the browser client. Empty (default) means
# the page origin itself, where the Go service listens. `nuxt dev` proxies
# /auth, /instances, /users and /media to a local Go service, so same-origin
# semantics (session cookie, no CORS) hold in development too.
# NUXT_PUBLIC_API_BASE_URL=
# Address the dev proxy forwards API paths to (default below).
# NUXT_DEV_PROXY_TARGET=http://127.0.0.1:8081
